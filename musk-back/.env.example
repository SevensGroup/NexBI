LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=sk-your-key
LLM_MODEL=gemini-3.5-flash
# Backup model. The previous DeepSeek key goes here. Used when the primary Gemini call fails.
LLM_FALLBACK_BASE_URL=https://api.deepseek.com/v1
LLM_FALLBACK_API_KEY=sk-your-key
LLM_FALLBACK_MODEL=deepseek-chat
AGENT_MAX_STEPS=30
AGENT_MAX_TASKS=12
AGENT_MAX_TOOL_CALLS=50
AGENT_MAX_RUNTIME=10m
AGENT_MAX_LLM_COST=1.0
TOOL_TIMEOUT=10s
ELASTICSEARCH_MCP_URL=http://127.0.0.1:8081/mcp
BI_PUBLIC_BASE_URL=http://localhost:5173
BI_DATABASE_DSN='root:password@tcp(127.0.0.1:3306)/sevens_bi?charset=utf8mb4&parseTime=true&loc=Local'
SEMANTIC_DIR=configs/semantic
SEMANTIC_MAX_TIME_RANGE=90d
SEMANTIC_MAX_RESULT_SIZE=100
MEMORY_POSTGRES_URL=postgres://agent:agent@127.0.0.1:5432/agent?sslmode=disable
MEMORY_SHORT_TERM_TTL=24h
MEMORY_TASK_TTL=7d
MEMORY_LONG_TERM_TTL=
MEMORY_SEARCH_LIMIT=20
GUARDRAIL_MEDIUM_AUTO=true
GUARDRAIL_APPROVAL_TTL=15m
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=autonomous-agent
RATE_LIMIT_RPS=20
CONCURRENCY_MAX=8
CONFIG_ENV=dev
